{
  "SshHost": "192.168.0.1",
  "SshUser": "your-ssh-user",
  "SshIdentityFile": "",
  "SshBatchMode": true,
  "SshStrictHostKeyChecking": "accept-new",
  "SshPort": 22,
  "DockerContainer": "home_assistant",
  "RemoteConfigPath": "/config/configuration.yaml",
  "LocalRelativePath": "configuration.yaml",
  "BackupOnPush": true,
  "LovelaceStorage": {
    "Enabled": true,
    "RemoteStorageDir": "/config/.storage",
    "LocalRelativeDir": ".storage"
  },
  "AssistantContextStorage": {
    "Enabled": true,
    "RemoteStorageDir": "/config/.storage",
    "LocalRelativeDir": ".ha-assistant-context",
    "Files": [
      "core.device_registry",
      "core.entity_registry",
      "core.config_entries",
      "core.area_registry",
      "core.label_registry"
    ]
  },
  "DevMirror": {
    "LocalRelativeDir": "dev/ha-config",
    "RemoteConfigDir": "/config"
  },
  "YamlArtifacts": [
    { "RemotePath": "/config/automations.yaml", "LocalRelativePath": "automations.yaml" },
    { "RemotePath": "/config/scripts.yaml", "LocalRelativePath": "scripts.yaml" },
    { "RemotePath": "/config/scenes.yaml", "LocalRelativePath": "scenes.yaml" }
  ]
}
